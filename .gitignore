# Credentials and secrets
.env
.env.*
*.pem
*.key
*.p12
credentials/
secrets.json

# Terraform
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
crash.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node (for tools that require it)
node_modules/

# OS files
Thumbs.db
.DS_Store
**/.DS_Store
governance-commons/**/.DS_Store 

# Editor local files
.claude/settings.local.json
CLAUDE.local.md
.zed/settings.local.json

# IDE files (if someone opens in other editors)
.idea/
.vscode/
*.swp
*.swo

# Build and cache
coverage/
.cache/
*.log

# Local temporary dependency installs created while exercising Codex hooks
pip/
.codex-tmp-pyyaml/

# MDD artifacts (if used)
.mdd/

# Trestle build output and local cache (not source artifacts)
governance-commons/catalogs/compliance/trestle-workspace/dist/
governance-commons/catalogs/compliance/trestle-workspace/.trestle/cache/
governance-commons/catalogs/compliance/trestle-workspace/.trestle/*.local
/.specify/presets/

# Trestle workspace internals (defensive; .keep and config.ini already listed specifically)
**/.trestle/

# governance-commons assembled catalogs: generated but committed so profiles can import them.
# The bare dist/ rule above also matches governance-commons/dist and excludes the whole
# directory; these lines re-include only the per-concern OSCAL catalogs under it.
!governance-commons/dist/
governance-commons/dist/*
!governance-commons/dist/concerns/
governance-commons/dist/concerns/*
!governance-commons/dist/concerns/*.oscal.yaml

# Capability index — machine-generated from source on every run; never committed.
.capability-index.json

# Substrate assembled index - generated by gc-assemble; STRUCTURE.md declares it git-ignored
governance-commons/dist/index.yaml

# Template sync (tooling/sync). state.json is the three-way merge base and
# overrides.yml is the deliberate-fork register; both are tracked on purpose
# so a fresh clone syncs identically. Only the local backup tree is ignored.
# In an application repo these lines govern what is committed; in this
# template repo the sync guard prevents .template-sync from being created at
# all, so they are here to seed every consuming app on first sync.
.template-sync/backup/
!.template-sync/state.json
!.template-sync/overrides.yml
